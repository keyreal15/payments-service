# Скопируйте в .env при необходимости: `cp .env.example .env`.
# Без .env всё работает на значениях по умолчанию (docker-compose.yml и app/config.py).
# После смены кредов PostgreSQL/RabbitMQ пересоздайте volumes: `make clean`
# (= docker compose --profile demo --profile test down -v).

# --- Порты на хосте (слушают только 127.0.0.1) ---
API_PORT=8000
RABBITMQ_MANAGEMENT_PORT=15672
WEBHOOK_RECEIVER_PORT=8090

# --- Креды инфраструктуры ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments
RABBITMQ_USER=payments
RABBITMQ_PASSWORD=payments

# --- Безопасность ---
API_KEY=dev-api-key
# HMAC-SHA256 подпись webhook (X-Webhook-Timestamp / X-Webhook-Signature); пустое значение — без подписи
WEBHOOK_SECRET=dev-webhook-secret
# Разрешить webhook на приватные адреса (нужно демо-приёмнику в сети compose); в проде — false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

# --- Приложение: раскомментируйте, чтобы переопределить значение по умолчанию ---
# LOG_LEVEL=INFO
# DOCS_ENABLED=true
# API_MAX_BODY_SIZE=65536
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_ECHO=false
# RABBITMQ_EXCHANGE=payments
# RABBITMQ_QUEUE=payments.new
# RABBITMQ_PUBLISH_TIMEOUT=10
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_POLL_INTERVAL=1.0
# OUTBOX_BATCH_SIZE=100
# OUTBOX_RETRY_BASE_DELAY=1.0
# OUTBOX_RETRY_MAX_DELAY=30
# CONSUMER_PREFETCH_COUNT=50
# CONSUMER_GRACEFUL_TIMEOUT=30
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=2.0
# RETRY_BACKOFF_MULTIPLIER=2.0
# GATEWAY_MIN_DELAY=2.0
# GATEWAY_MAX_DELAY=5.0
# GATEWAY_SUCCESS_RATE=0.9
# GATEWAY_ERROR_RATE=0.0
# GATEWAY_TIMEOUT=15
# WEBHOOK_TIMEOUT=5.0
